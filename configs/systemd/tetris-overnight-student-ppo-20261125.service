[Unit]
Description=Make-up Codex-supervised Tetris PPO training for the night of 2026-11-25

[Service]
Type=exec
WorkingDirectory=%h/projects/tetris-ai-benchmark
Environment="PATH=%h/.nvm/versions/node/v24.18.0/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=%h/.config/systemd/user/tetris-overnight-codex-network.env
ExecStart=%h/projects/tetris-ai-benchmark/.venv/bin/python %h/projects/tetris-ai-benchmark/scripts/supervise_overnight_student_ppo.py --output %h/projects/tetris-ai-benchmark/runs/overnight_student_ppo_20261125 --start 2026-11-25T00:30:00+08:00 --end 2026-11-25T08:20:00+08:00 --initial-variant try_anchor --report reports/experiments/overnight_student_ppo_20261125.json
RuntimeMaxSec=8h
TimeoutStopSec=30s
StandardOutput=append:%h/projects/tetris-ai-benchmark/runs/overnight_student_ppo_20261125/service.log
StandardError=append:%h/projects/tetris-ai-benchmark/runs/overnight_student_ppo_20261125/service.log
