[Unit]
Description=Check authorized local Tetris backend without desktop dependency
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/wyh/projects/tetris-ai-benchmark
ExecStart=/home/wyh/projects/tetris-ai-benchmark/.venv/bin/python /home/wyh/projects/tetris-ai-benchmark/scripts/unattended_watchdog.py --control /home/wyh/projects/tetris-ai-benchmark/runs/autonomous_development_20261105/control.json
Environment="PATH=/home/wyh/.local/bin:/home/wyh/.nvm/versions/node/v24.18.0/bin:/usr/local/bin:/usr/bin:/bin"
TimeoutStartSec=120
MemoryMax=256M
CPUQuota=10%
Nice=10
