[Unit]
Description=Codex-supervised Tetris PPO training for the night of 2026-11-24

[Service]
Type=exec
WorkingDirectory=%h/projects/tetris-ai-benchmark
EnvironmentFile=%h/.config/systemd/user/tetris-overnight-codex-network.env
ExecStart=%h/projects/tetris-ai-benchmark/.venv/bin/python %h/projects/tetris-ai-benchmark/scripts/supervise_overnight_student_ppo.py --output %h/projects/tetris-ai-benchmark/runs/overnight_student_ppo_20261124 --start 2026-11-24T00:30:00+08:00 --end 2026-11-24T08:20:00+08:00
RuntimeMaxSec=8h
TimeoutStopSec=30s
StandardOutput=append:%h/projects/tetris-ai-benchmark/runs/overnight_student_ppo_20261124/service.log
StandardError=append:%h/projects/tetris-ai-benchmark/runs/overnight_student_ppo_20261124/service.log
