[Unit]
Description=Complete the approved guarded Tetris development budget unattended
Wants=tetris-lr-longcap-20261105.service
After=tetris-lr-longcap-20261105.service

[Service]
Type=simple
WorkingDirectory=/home/wyh/projects/tetris-ai-benchmark
ExecStart=/home/wyh/projects/tetris-ai-benchmark/.venv/bin/python -u /home/wyh/projects/tetris-ai-benchmark/scripts/run_unattended_extension.py --run-dir /home/wyh/projects/tetris-ai-benchmark/runs/autonomous_lr_unattended_20261105
Slice=tetris-compute.slice
CPUQuota=50%
MemoryMax=1G
MemorySwapMax=0
Environment=PATH=/home/wyh/.local/bin:/home/wyh/.nvm/versions/node/v24.18.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
TimeoutStopSec=40
KillMode=mixed
RuntimeMaxSec=6h

[Install]
WantedBy=default.target
